# Commercetools
CTP_PROJECT_KEY=your-project-key
CTP_CLIENT_ID=your-client-id
CTP_CLIENT_SECRET=your-client-secret
CTP_REGION=europe-west1.gcp
# Optional, space-separated OAuth scopes. Unset: the token gets the scopes of the API client.
# Least-privilege set for this library (see docs/CONFIGURATION.md#least-privilege-api-client):
# CTP_SCOPES=view_published_products:your-project-key view_products:your-project-key manage_orders:your-project-key manage_payments:your-project-key manage_customers:your-project-key
# Opt in to the deprecated Product Projection Search fallback when Product Search is not enabled
# (off by default since 3.0.0).
# CAT_LEGACY_PRODUCT_PROJECTION_SEARCH=true

# HMAC secret for customer cart session tokens, at least 32 bytes (UTF-8): generate one with
# `openssl rand -base64 48`. Required whenever NODE_ENV is not "development" or "test" (including
# unset), so `next start` and `pnpm start` need it. In development (`next dev`, `pnpm dev:bff`)
# an unset secret becomes a random per-process one (customer sessions end on restart).
# CAT_CART_SESSION_SECRET=

# AI Provider: openrouter | bedrock
CAT_AI_PROVIDER=openrouter
OPENROUTER_API_KEY=your-openrouter-api-key
OPENROUTER_MODEL=openai/gpt-5.6-luna
OPENROUTER_VISION_MODEL=google/gemini-3.7-flash
OPENROUTER_VOICE_MODEL=google/gemini-3.7-flash
# OPENROUTER_JSON_SCHEMA=false

# AWS Bedrock (when CAT_AI_PROVIDER=bedrock)
# AWS_REGION=us-east-1
# BEDROCK_MODEL_ID=anthropic.claude-3-5-sonnet-20241022-v2:0
# BEDROCK_VISION_MODEL_ID=anthropic.claude-3-5-sonnet-20241022-v2:0

# Voice: openrouter-audio (default with OpenRouter) | elevenlabs-stt
# Invalid enum or numeric values (CAT_AI_PROVIDER, CAT_VOICE_MODE, CAT_*_MS, CAT_*_ENTRIES, ...)
# make the server fail at startup.
# CAT_VOICE_MODE=openrouter-audio
# Spoken summary: deterministic template by default. true = LLM-written summary
# (one extra LLM call per voice search). Only true or false are accepted.
# CAT_VOICE_LLM_SUMMARY=false

# ElevenLabs (TTS for voice summary; STT only when CAT_VOICE_MODE=elevenlabs-stt)
ELEVENLABS_API_KEY=your-elevenlabs-api-key
# STT models: scribe_v2 (default) | scribe_v1 | scribe_v2_medical | scribe_v3
ELEVENLABS_STT_MODEL=scribe_v2
ELEVENLABS_TTS_VOICE_ID=JBFqnCBsd6RMkjVDRZzb
ELEVENLABS_TTS_MODEL=eleven_multilingual_v2

# Defaults
# Language products are indexed in commercetools (must match project languages)
CAT_CATALOG_LOCALE=en-GB
CAT_DEFAULT_CURRENCY=EUR
# ISO country used for cart and product-card price selection.
# Must match the country on product prices (GBP catalogs are typically GB, not DE).
CAT_DEFAULT_COUNTRY=DE
CAT_DEFAULT_LIMIT=20

# Product Search (REST) returns IDs + facets; card fields are hydrated via commercetools GraphQL
# using the same CTP_* credentials (no extra GraphQL env vars).

# Optional allowlist of locales clients may send (comma-separated, BCP 47).
# Restricts catalog locales only (queryLocale, the shopper's language, is never restricted).
# Other catalog locales fall back to CAT_CATALOG_LOCALE. Unset: any well-formed locale is accepted.
# CAT_SUPPORTED_LOCALES=en-GB,de-DE

# Deprecated: use CAT_CATALOG_LOCALE instead
# CAT_DEFAULT_LOCALE=en

# Dev tracing (logs search pipeline and commercetools requests)
# CAT_DEBUG=true
# CAT_DEBUG_RAW=true  # also log shopper text verbatim (default: length and hash)

# Langfuse AI observability (opt-in; both keys required)
# LANGFUSE_PUBLIC_KEY=pk-lf-...
# LANGFUSE_SECRET_KEY=sk-lf-...
# LANGFUSE_BASE_URL=https://cloud.langfuse.com
# Self-host or other regions: https://us.cloud.langfuse.com, etc.
# LANGFUSE_TRACE_SUGGESTIONS=true  # optional; autocomplete spans are off by default
# Managed system prompts (opt-in; requires keys above + sync script)
# LANGFUSE_PROMPTS=true
# LANGFUSE_PROMPT_LABEL=production
# LANGFUSE_PROMPT_CACHE_TTL_SECONDS=60
# LANGFUSE_PROMPT_FETCH_TIMEOUT_MS=2000
# LANGFUSE_PROMPT_MAX_RETRIES=0
# Sync local catalog → Langfuse staging: pnpm sync:langfuse-prompts
# Promote after evals: pnpm sync:langfuse-prompts -- --label production

# Optional short-lived search cache (in-memory per process; not shared across instances)
# CAT_CACHE_ENABLED=true
# CAT_CACHE_TTL_MS=60000
# CAT_CACHE_MAX_ENTRIES=500
# Caches text search, interpreted queries, suggestions, voice (full audio hash), and image search.

# Optional multi-item shopping missions (extra LLM call per fresh text search)
# CAT_MISSIONS_ENABLED=true   # false hard-disables missions even when a request asks for them
# CAT_MISSIONS_MAX_INTENTS=5
# CAT_MISSIONS_PER_INTENT_LIMIT=4
# CAT_MISSIONS_MIN_CONFIDENCE=0.6

# Optional schema-driven faceted search (Product Type attributes must be isSearchable)
# CAT_FACETS_ENABLED=true
# CAT_FACET_SCHEMA_TTL_MS=600000
# CAT_FACET_INCLUDE=color,size,height
# CAT_FACET_EXCLUDE=internalCode
# CAT_FACET_MAX_ATTRIBUTES=12

# Payments: inject PaymentProvider in host code (see README). When a provider is set,
# order creation requires a successful authorization unless you override:
# CAT_PAYMENT_REQUIRED=false

# Demo only: inject the mock payment provider, which authorizes every payment
# (except the 13.13 insufficient-funds probe). Never enable against a real project
# on a public deployment.
CAT_DEMO_MOCK_PAYMENTS=true

# Autocomplete uses commercetools Search Term Suggestions (requires Product Projection Search
# and SearchKeywords configured in your project). Enable in the widget with enableAutocomplete.

# Demo widget (optional client-side overrides)
# NEXT_PUBLIC_CAT_CATALOG_LOCALE=en-GB
# NEXT_PUBLIC_CAT_QUERY_LOCALE=en
# NEXT_PUBLIC_CAT_CURRENCY=EUR
# NEXT_PUBLIC_CAT_COUNTRY=DE
