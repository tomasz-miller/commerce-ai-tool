{
  "name": "demo-angular",
  "version": "0.1.0-alpha.0",
  "private": true,
  "description": "Angular demo host for Commerce AI Tool — search, cart, missions, checkout, and orders against the shared commerce-ai BFF",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n bff,ui \"pnpm dev:bff\" \"pnpm dev:ui\"",
    "dev:ui": "ng serve --port 4200 --proxy-config proxy.conf.json",
    "dev:bff": "tsx watch server/dev.ts",
    "build": "ng build && tsc -p tsconfig.server.json",
    "start": "node dist-server/index.js",
    "lint": "eslint src server --config ../../eslint.config.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.app.json && tsc --noEmit -p tsconfig.server.json",
    "test": "vitest run",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@angular/common": "21.2.26",
    "@angular/core": "21.2.26",
    "@angular/forms": "21.2.26",
    "@angular/platform-browser": "21.2.26",
    "@angular/router": "21.2.26",
    "@commerce-ai-tool/angular": "workspace:*",
    "@commerce-ai-tool/core": "workspace:*",
    "@commerce-ai-tool/styles": "workspace:*",
    "rxjs": "^7.8.2",
    "tslib": "^2.9.1"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "21.2.30",
    "@angular/cli": "21.2.30",
    "@angular/compiler": "21.2.26",
    "@angular/compiler-cli": "21.2.26",
    "@commerce-ai-tool/server": "workspace:*",
    "@langfuse/otel": "catalog:",
    "@opentelemetry/sdk-node": "^0.301.2",
    "@playwright/test": "catalog:",
    "@types/express": "^5.0.0",
    "@types/node": "catalog:",
    "concurrently": "^10.0.7",
    "dotenv": "^16.4.5",
    "eslint": "^10.14.0",
    "express": "catalog:",
    "jsdom": "catalog:",
    "tsx": "^4.23.15",
    "typescript": "~5.9.2",
    "vite": "catalog:",
    "vitest": "catalog:"
  }
}
