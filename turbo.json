{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "../../scripts/emit-package-dts.mjs",
        "../../scripts/inline-core-client-dts.mjs",
        "../../scripts/check-angular-apf.mjs"
      ],
      "outputs": ["dist/**", "dist-server/**", ".next/**", "!.next/cache/**"]
    },
    "dev": {
      "dependsOn": ["^build", "build"],
      "cache": false,
      "persistent": true
    },
    "demo-next#dev": {
      "dependsOn": ["^build"],
      "cache": false,
      "persistent": true
    },
    "demo-angular#dev": {
      "dependsOn": ["^build"],
      "cache": false,
      "persistent": true
    },
    "lint": {
      "dependsOn": ["^build"]
    },
    "@commerce-ai-tool/styles#lint": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", "../../scripts/check-contrast.mjs"]
    },
    "typecheck": {
      "dependsOn": ["^build"]
    },
    "test": {
      "dependsOn": ["^build"]
    },
    "clean": {
      "cache": false
    }
  }
}
