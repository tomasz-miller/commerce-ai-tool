{
  "name": "@commerce-ai-tool/angular",
  "version": "3.0.0",
  "description": "Angular component for Commerce AI Tool — glass morphism product search widget",
  "license": "MIT",
  "type": "module",
  "exports": {
    "./styles.css": "./commerce-ai-search.css"
  },
  "sideEffects": [
    "**/*.css"
  ],
  "scripts": {
    "build": "ng-packagr -p ng-package.json -c tsconfig.lib.prod.json && node ../../scripts/check-angular-apf.mjs",
    "dev": "ng-packagr -p ng-package.json -c tsconfig.lib.prod.json --watch",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src",
    "check:package": "attw --pack dist --profile esm-only --exclude-entrypoints ./styles.css && publint",
    "test": "vitest run",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@commerce-ai-tool/core": "workspace:*",
    "tslib": "^2.9.1"
  },
  "peerDependencies": {
    "@angular/common": "^20.3.0 || ^21.0.0 || ^22.0.0",
    "@angular/core": "^20.3.0 || ^21.0.0 || ^22.0.0",
    "@angular/forms": "^20.3.0 || ^21.0.0 || ^22.0.0",
    "rxjs": ">=7"
  },
  "devDependencies": {
    "@angular/common": "^20.3.35",
    "@angular/compiler": "^20.3.35",
    "@angular/compiler-cli": "^20.3.35",
    "@angular/core": "^22.2.6",
    "@angular/forms": "^20.3.35",
    "@angular/platform-browser": "^20.3.35",
    "@commerce-ai-tool/styles": "workspace:*",
    "jsdom": "catalog:",
    "ng-packagr": "^20.3.2",
    "rxjs": "^7.8.2",
    "typescript": "~5.9.3",
    "vite": "catalog:",
    "vitest": "catalog:"
  },
  "publishConfig": {
    "access": "public",
    "directory": "dist",
    "linkDirectory": true
  },
  "author": {
    "name": "Tomasz Miller",
    "url": "https://github.com/tomasz-miller"
  },
  "homepage": "https://github.com/tomasz-miller/commerce-ai-tool#readme",
  "bugs": {
    "url": "https://github.com/tomasz-miller/commerce-ai-tool/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tomasz-miller/commerce-ai-tool.git",
    "directory": "packages/angular"
  },
  "keywords": [
    "commercetools",
    "ai",
    "search",
    "angular",
    "widget"
  ],
  "engines": {
    "node": ">=24"
  }
}
