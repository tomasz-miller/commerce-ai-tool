{
  "name": "@commerce-ai-tool/angular",
  "version": "2.4.0",
  "description": "Angular component for Commerce AI Tool \u2014 glass morphism product search widget",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./styles.css": "./dist/index.css"
  },
  "files": [
    "dist",
    "CHANGELOG.md"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "scripts": {
    "build": "tsup && node ../../scripts/emit-package-dts.mjs dist/index.d.ts && node ../../scripts/inline-core-client-dts.mjs",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src",
    "test": "vitest run",
    "clean": "rm -rf dist"
  },
  "peerDependencies": {
    "@angular/common": ">=17",
    "@angular/core": ">=17",
    "@angular/forms": ">=17",
    "rxjs": ">=7"
  },
  "devDependencies": {
    "@commerce-ai-tool/core": "workspace:*",
    "@angular/common": "^20.3.27",
    "@angular/compiler": "^20.3.27",
    "@angular/core": "^20.3.27",
    "@angular/forms": "^19.2.3",
    "@angular/platform-browser": "^19.2.3",
    "rxjs": "^7.8.2",
    "tsup": "^8.4.0",
    "@typescript/native": "catalog:",
    "vitest": "^5.0.0",
    "zone.js": "^0.15.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "author": {
    "name": "Tomasz Miller",
    "url": "https://github.com/tomasz-miller"
  },
  "homepage": "https://github.com/tomasz-miller/commerce-ai-tool#readme",
  "bugs": {
    "url": "https://github.com/tomasz-miller/commerce-ai-tool/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tomasz-miller/commerce-ai-tool.git",
    "directory": "packages/angular"
  },
  "keywords": [
    "commercetools",
    "ai",
    "search",
    "angular",
    "widget"
  ],
  "engines": {
    "node": ">=24"
  }
}
