{
  "name": "@commerce-ai-tool/core",
  "version": "3.0.0",
  "description": "Core business logic for Commerce AI Tool — commercetools search with AI interpretation",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/cjs/index.d.ts",
        "default": "./dist/index.cjs"
      }
    },
    "./client": {
      "import": {
        "types": "./dist/client.d.ts",
        "default": "./dist/client.js"
      },
      "require": {
        "types": "./dist/cjs/client.d.ts",
        "default": "./dist/client.cjs"
      }
    },
    "./internal": {
      "import": {
        "types": "./dist/internal.d.ts",
        "default": "./dist/internal.js"
      },
      "require": {
        "types": "./dist/cjs/internal.d.ts",
        "default": "./dist/internal.cjs"
      }
    }
  },
  "typesVersions": {
    "*": {
      "client": [
        "./dist/client.d.ts"
      ],
      "internal": [
        "./dist/internal.d.ts"
      ]
    }
  },
  "files": [
    "dist",
    "CHANGELOG.md"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsup && node ../../scripts/emit-package-dts.mjs dist/index.d.ts dist/client.d.ts dist/internal.d.ts",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src",
    "check:package": "attw --pack . && publint",
    "test": "vitest run",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@aws-sdk/client-bedrock-runtime": "^3.1175.0",
    "@commercetools/platform-sdk": "^9.8.0",
    "@commercetools/ts-client": "^5.2.0",
    "@langfuse/client": "catalog:",
    "@langfuse/tracing": "catalog:",
    "@openrouter/sdk": "^1.5.128",
    "@opentelemetry/api": "^1.10.0"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "@typescript/native": "catalog:",
    "tsup": "catalog:",
    "vite": "catalog:",
    "jsdom": "catalog:",
    "vitest": "catalog:"
  },
  "publishConfig": {
    "access": "public"
  },
  "author": {
    "name": "Tomasz Miller",
    "url": "https://github.com/tomasz-miller"
  },
  "homepage": "https://github.com/tomasz-miller/commerce-ai-tool#readme",
  "bugs": {
    "url": "https://github.com/tomasz-miller/commerce-ai-tool/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tomasz-miller/commerce-ai-tool.git",
    "directory": "packages/core"
  },
  "keywords": [
    "commercetools",
    "ai",
    "search",
    "openrouter",
    "bedrock"
  ],
  "engines": {
    "node": ">=24"
  }
}
