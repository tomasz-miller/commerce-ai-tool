{
  "name": "@commerce-ai-tool/core",
  "version": "2.4.0",
  "description": "Core business logic for Commerce AI Tool — commercetools search with AI interpretation",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./client": {
      "import": {
        "types": "./dist/client.d.ts",
        "default": "./dist/client.js"
      },
      "require": {
        "types": "./dist/client.d.cts",
        "default": "./dist/client.cjs"
      }
    }
  },
  "files": [
    "dist",
    "CHANGELOG.md"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsup && node ../../scripts/emit-package-dts.mjs dist/index.d.ts dist/client.d.ts",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src",
    "test": "vitest run",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@aws-sdk/client-bedrock-runtime": "^3.758.0",
    "@commercetools/platform-sdk": "^8.0.0",
    "@commercetools/sdk-client-v2": "^3.4.0",
    "@langfuse/client": "^5.9.1",
    "@langfuse/tracing": "^5.9.1",
    "@openrouter/sdk": "^0.1.11",
    "@opentelemetry/api": "^1.9.1"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@typescript/native": "catalog:",
    "tsup": "^8.4.0",
    "vitest": "^5.0.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "author": {
    "name": "Tomasz Miller",
    "url": "https://github.com/tomasz-miller"
  },
  "homepage": "https://github.com/tomasz-miller/commerce-ai-tool#readme",
  "bugs": {
    "url": "https://github.com/tomasz-miller/commerce-ai-tool/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tomasz-miller/commerce-ai-tool.git",
    "directory": "packages/core"
  },
  "keywords": [
    "commercetools",
    "ai",
    "search",
    "openrouter",
    "bedrock"
  ],
  "engines": {
    "node": ">=24"
  }
}
