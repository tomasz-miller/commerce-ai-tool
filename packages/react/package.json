{
  "name": "@commerce-ai-tool/react",
  "version": "2.4.0",
  "description": "React component for Commerce AI Tool \u2014 glass morphism product search widget",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./styles.css": "./dist/index.css"
  },
  "files": [
    "dist",
    "CHANGELOG.md"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "scripts": {
    "build": "tsup && node ../../scripts/emit-package-dts.mjs dist/index.d.ts && node ../../scripts/inline-core-client-dts.mjs",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src",
    "test": "vitest run",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "lucide-react": "^0.484.0"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18"
  },
  "devDependencies": {
    "@commerce-ai-tool/core": "workspace:*",
    "@testing-library/react": "^16.2.0",
    "@types/react": "^19.0.12",
    "@types/react-dom": "^19.0.4",
    "jsdom": "^26.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tsup": "^8.4.0",
    "@typescript/native": "catalog:",
    "vitest": "^3.0.9"
  },
  "publishConfig": {
    "access": "public"
  },
  "author": {
    "name": "Tomasz Miller",
    "url": "https://github.com/tomasz-miller"
  },
  "homepage": "https://github.com/tomasz-miller/commerce-ai-tool#readme",
  "bugs": {
    "url": "https://github.com/tomasz-miller/commerce-ai-tool/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tomasz-miller/commerce-ai-tool.git",
    "directory": "packages/react"
  },
  "keywords": [
    "commercetools",
    "ai",
    "search",
    "react",
    "nextjs",
    "widget"
  ],
  "engines": {
    "node": ">=24"
  }
}
