{
  "name": "@commerce-ai-tool/server",
  "version": "3.0.0",
  "description": "Server-side API handlers for Commerce AI Tool",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/cjs/index.d.ts",
        "default": "./dist/index.cjs"
      }
    },
    "./next": {
      "import": {
        "types": "./dist/next.d.ts",
        "default": "./dist/next.js"
      },
      "require": {
        "types": "./dist/cjs/next.d.ts",
        "default": "./dist/next.cjs"
      }
    },
    "./express": {
      "import": {
        "types": "./dist/express.d.ts",
        "default": "./dist/express.js"
      },
      "require": {
        "types": "./dist/cjs/express.d.ts",
        "default": "./dist/express.cjs"
      }
    },
    "./flush": {
      "import": {
        "types": "./dist/flush.d.ts",
        "default": "./dist/flush.js"
      },
      "require": {
        "types": "./dist/cjs/flush.d.ts",
        "default": "./dist/flush.cjs"
      }
    }
  },
  "typesVersions": {
    "*": {
      "next": [
        "./dist/next.d.ts"
      ],
      "express": [
        "./dist/express.d.ts"
      ],
      "flush": [
        "./dist/flush.d.ts"
      ]
    }
  },
  "files": [
    "dist",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "tsup && node ../../scripts/emit-package-dts.mjs dist/index.d.ts dist/next.d.ts dist/express.d.ts dist/flush.d.ts",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src",
    "check:package": "attw --pack . && publint",
    "test": "vitest run",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@commerce-ai-tool/core": "workspace:*",
    "@elevenlabs/elevenlabs-js": "^2.79.0",
    "busboy": "^1.6.0",
    "cors": "^2.8.5",
    "express-rate-limit": "^8.7.5"
  },
  "peerDependencies": {
    "express": "^5.0.0"
  },
  "peerDependenciesMeta": {
    "express": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/busboy": "^1.5.5",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/node": "catalog:",
    "@types/supertest": "^6.0.3",
    "@typescript/native": "catalog:",
    "express": "catalog:",
    "supertest": "^7.3.2",
    "tsup": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:"
  },
  "publishConfig": {
    "access": "public"
  },
  "author": {
    "name": "Tomasz Miller",
    "url": "https://github.com/tomasz-miller"
  },
  "homepage": "https://github.com/tomasz-miller/commerce-ai-tool#readme",
  "bugs": {
    "url": "https://github.com/tomasz-miller/commerce-ai-tool/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tomasz-miller/commerce-ai-tool.git",
    "directory": "packages/server"
  },
  "keywords": [
    "commercetools",
    "ai",
    "search",
    "nextjs",
    "express",
    "bff"
  ],
  "engines": {
    "node": ">=24"
  }
}
