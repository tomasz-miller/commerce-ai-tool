    "@angular/platform-browser": "ANGULAR_RANGE",
    "@commerce-ai-tool/angular": "TARBALL_ANGULAR",
    "rxjs": "^7.8.2",
    "tslib": "^2.8.1"
  },
  "devDependencies": {
    "@angular/build": "ANGULAR_RANGE",
    "@angular/cli": "ANGULAR_RANGE",
    "@angular/compiler-cli": "ANGULAR_RANGE",
    "typescript": "~5.9.3"
  },
  "overrides": {
    "@commerce-ai-tool/core": "TARBALL_CORE"
  }
}
